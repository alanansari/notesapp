PORT=4000
MONGODB_URI=mongodb://localhost:27017/noted
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,app://noted
# Verification emails are sent through Resend (https://resend.com). Without a key,
# codes are printed to the server log instead (development only).
RESEND_API_KEY=
EMAIL_FROM=Noted <no-reply@your-domain.com>
