{
  "name": "noted",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@noted/web --filter=@noted/desktop --filter=@noted/api",
    "dev:web": "turbo run dev --filter=@noted/web",
    "dev:desktop": "turbo run dev --filter=@noted/desktop",
    "dev:api": "turbo run dev --filter=@noted/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3"
  }
}
